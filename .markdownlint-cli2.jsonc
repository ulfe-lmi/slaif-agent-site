{
  "config": {
    "default": true,
    "MD013": false,
    "MD009": { "br_spaces": 2, "strict": true },
    "MD025": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["div", "a", "img"] },
    "MD022": false,
    "MD029": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    ".git/**",
    "oap/strategic-instructions/**",
    // Immutable 010-i report predates the mandatory pre-publication lint gate.
    "oap/reports/010-i-qualify-session-finalizer-update.md",
    // Immutable strategic prose contains a literal line beginning `#23,`.
    "oap/orders/011-b-platform-admin-site-http.md",
    "**/node_modules/**",
    ".venv/**"
  ],
  "overrides": [
    {
      "filter": ["oap/reports/013-l-diagnose-modal-containment-timeout.md"],
      "config": { "MD032": false },
      "combine": "merge"
    },
    {
      "filter": ["oap/orders/014-a-content-model-foundation.md"],
      "config": { "MD031": false, "MD032": false, "MD040": false },
      "combine": "merge"
    },
    {
      "filter": ["oap/orders/015-a-content-model-editor-http.md"],
      "config": { "MD031": false, "MD032": false, "MD040": false },
      "combine": "merge"
    },
    {
      "filter": ["oap/MVP-PROGRESS.md", "oap/orders/022-a-media-foundation.md", "oap/reports/022-a-media-foundation.md"],
      "config": { "MD031": false, "MD032": false, "MD040": false, "MD058": false },
      "combine": "merge"
    },
    {
      "filter": ["docs/user-manual/**/*.md"],
      "config": { "MD031": false, "MD032": false, "MD040": false, "MD058": false },
      "combine": "merge"
    },
    {
      "filter": ["oap/orders/070-d-media-cross-worker-publication-race-proof.md"],
      "config": { "MD018": false },
      "combine": "merge"
    }
  ]
}
